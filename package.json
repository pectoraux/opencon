{
  "name": "opencon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open Contribution Protocol — modular monolith foundation (NET-W001).",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:run": "bun test",
    "arch:check": "bun scripts/check-architecture.ts",
    "verify": "bun run typecheck && bun run arch:check && bun test"
  },
  "dependencies": {
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
