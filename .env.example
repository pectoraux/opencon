# OpenCon NET-W001 example environment.
#
# This file documents the configuration surface ONLY. It contains no real
# secrets. Real values must be supplied out-of-band (e.g. via the runtime
# SecretProvider) and must NEVER be committed.
#
# See src/config/schema.ts for validation rules and required/optional
# classification. Startup fails fast (see src/server.ts) when a REQUIRED
# value is missing or invalid.

# ---- Application ----
# REQUIRED. Runtime environment selector. Drives safe defaults.
APP_ENV=development

# OPTIONAL. HTTP listen port for the /api boundary. Default: 8787.
PORT=8787

# OPTIONAL. Human-readable deployment label.
APP_NAME=opencon

# ---- Secrets (classification: required in non-development environments) ----
# These are PLACEHOLDERS only. The SecretProvider resolves them at runtime.
# In development a safe local default is used; in production startup fails
# fast if a required secret is absent.
DATABASE_URL=postgres://placeholder:not-a-secret@localhost:5432/opencon
REDIS_URL=redis://placeholder@localhost:6379
OBJECT_STORAGE_BUCKET=opencon-dev

# ---- Measurement provider secrets (NET-W022, OPTIONAL) ----
# HMAC-SHA256 verification keys for the reference attribution adapters
# (ADAPTER-003 browser/platform attribution + ADAPTER-004 iOS
# attribution). When a key is present the respective adapter is
# auto-wired; when absent, pushed reports for that provider FAIL
# CLOSED (unverifiable integrity). Resolved ONLY through the
# SecretProvider — never logged, persisted, or echoed into
# audit/error payloads (PRIV-002).
# MEASUREMENT_BROWSER_ATTRIBUTION_KEY=
# MEASUREMENT_IOS_ATTRIBUTION_KEY=

# ---- Delivery-notice measurement secret (NET-W023, OPTIONAL) ----
# HMAC-SHA256 verification key for the reference delivery-notice
# measurement adapter (the sanctioned measurement routing path:
# external delivery facts flow through the push-report ingestion chain
# into /outcomes). Same wiring rule: present → auto-wired; absent →
# pushed notices FAIL CLOSED. Resolved ONLY through the SecretProvider
# (PRIV-002).
# MEASUREMENT_OPENRTB_DELIVERY_KEY=

# ---- Observability ----
# OPTIONAL. Minimum log level emitted by the structured logger.
LOG_LEVEL=info

# OPTIONAL. Emit pretty (human-readable) logs in development. JSON in production.
LOG_PRETTY=true
