# OpenCon NET-W001 example environment.
#
# This file documents the configuration surface ONLY. It contains no real
# secrets. Real values must be supplied out-of-band (e.g. via the runtime
# SecretProvider) and must NEVER be committed.
#
# See src/config/schema.ts for validation rules and required/optional
# classification. Startup fails fast (see src/server.ts) when a REQUIRED
# value is missing or invalid.

# ---- Application ----
# REQUIRED. Runtime environment selector. Drives safe defaults.
APP_ENV=development

# OPTIONAL. HTTP listen port for the /api boundary. Default: 8787.
PORT=8787

# OPTIONAL. Human-readable deployment label.
APP_NAME=opencon

# ---- Secrets (classification: required in non-development environments) ----
# These are PLACEHOLDERS only. The SecretProvider resolves them at runtime.
# In development a safe local default is used; in production startup fails
# fast if a required secret is absent.
DATABASE_URL=postgres://placeholder:not-a-secret@localhost:5432/opencon
REDIS_URL=redis://placeholder@localhost:6379
OBJECT_STORAGE_BUCKET=opencon-dev

# ---- Measurement provider secrets (NET-W022, OPTIONAL) ----
# HMAC-SHA256 verification keys for the reference attribution adapters
# (ADAPTER-003 browser/platform attribution + ADAPTER-004 iOS
# attribution). When a key is present the respective adapter is
# auto-wired; when absent, pushed reports for that provider FAIL
# CLOSED (unverifiable integrity). Resolved ONLY through the
# SecretProvider — never logged, persisted, or echoed into
# audit/error payloads (PRIV-002).
# MEASUREMENT_BROWSER_ATTRIBUTION_KEY=
# MEASUREMENT_IOS_ATTRIBUTION_KEY=

# ---- Delivery-notice measurement secret (NET-W023, OPTIONAL) ----
# HMAC-SHA256 verification key for the reference delivery-notice
# measurement adapter (the sanctioned measurement routing path:
# external delivery facts flow through the push-report ingestion chain
# into /outcomes). Same wiring rule: present → auto-wired; absent →
# pushed notices FAIL CLOSED. Resolved ONLY through the SecretProvider
# (PRIV-002).
# MEASUREMENT_OPENRTB_DELIVERY_KEY=

# ---- Observability ----
# OPTIONAL. Minimum log level emitted by the structured logger.
LOG_LEVEL=info

# OPTIONAL. Emit pretty (human-readable) logs in development. JSON in production.
LOG_PRETTY=true

# ---- Seller-authorization trust secret (NET-W023 PR #47 remediation, OPTIONAL) ----
# HMAC-SHA256 trust-channel key for supply-chain verification: when
# present, the OpenRTB ingress authenticates seller-authorization
# trust envelopes (ads.txt / app-ads.txt / sellers.json submissions
# signed by the trusted supply-chain collector channel) and only
# AUTHENTICATED + FRESH + CONSISTENT evidence can produce a `verified`
# supply chain; when absent, NO chain can be `verified` (fail closed).
# Resolved ONLY through the SecretProvider (PRIV-002).
# SELLER_AUTHORIZATION_TRUST_KEY=

# ---- External settlement provider trust secrets (NET-W030, OPTIONAL) ----
# Per-provider HMAC-SHA256 trust keys for the external settlement
# adapter channel (ADAPTER-008): when present, the respective
# provider's submissions are authenticated and can be recorded as
# external settlement transaction FACTS inside /settlement; when
# absent, ingestion for that provider fails closed (`unauthenticated`
# — nothing is ever recorded). The key map is closed over the frozen
# provider vocabulary (NET-W030: `reference`). Resolved ONLY through
# the SecretProvider (PRIV-002).
# EXTERNAL_SETTLEMENT_REFERENCE_TRUST_KEY=

# ---- Versioned attestation signing (NET-W029, OPTIONAL) ----
# NON-SECRET: the production signature algorithm for the signed-
# attestation (v2) surface — one of ed25519 | ecdsa-p256 | hmac-sha256.
# Default "hmac-sha256" (existing deployments keep booting unchanged;
# the ATTESTATION_SIGNING_KEY secret above serves that path).
# ATTESTATION_SIGNING_ALGORITHM=hmac-sha256
#
# SECRET (ed25519 selected): the Ed25519 private key in PKCS#8 PEM
# form. Resolved ONLY through the SecretProvider at composition time;
# never logged, persisted, or echoed. When ATTESTATION_SIGNING_ALGORITHM
# is "ed25519" in production/staging and this secret is absent or
# invalid, startup FAILS CLOSED (ProviderConfigurationError).
# ATTESTATION_SIGNING_ED25519_PRIVATE_KEY=
#
# SECRET (ecdsa-p256 selected): the ECDSA P-256 private key in PKCS#8
# PEM form. Same wiring rule as the Ed25519 key: SecretProvider only;
# fail closed when the algorithm is selected without a usable key.
# ATTESTATION_SIGNING_ECDSA_PRIVATE_KEY=
